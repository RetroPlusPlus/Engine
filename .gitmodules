# SameBoy — pinned to release v1.0.3 (commit 208ba4a). The gitlink commit object
# is the authoritative pin; this note records which release it corresponds to.
# Vendored for the runtime VM and the fidelity harness.
[submodule "third_party/sameboy"]
	path = third_party/sameboy
	url = https://github.com/LIJI32/SameBoy.git
# SDL3 — pinned to release-3.4.10 (commit 8e37db5e). The gitlink commit object is
# the authoritative pin; this note records which release it corresponds to. Built
# statically from source via add_subdirectory and linked into retropp::engine (the
# SDL_GPU backend is the project-locked platform boundary). Subsystems trimmed to
# video + events + gamepad; the audio backend lands with the audio chain.
[submodule "third_party/sdl"]
	path = third_party/sdl
	url = https://github.com/libsdl-org/SDL.git
# Snaggletooth — the clean-room MIT SNES implementation (audio-first: SPC700 + S-DSP),
# our own project developed IN PLACE in this checkout (its own repo; Polyrhythm pins the
# gitlink like any vendored dependency, but the contents are authored here). The engine
# consumes it behind the VmBackend seam (VMPlatform::Snes); not compiled until the
# adapter unit wires it into the build.
[submodule "third_party/snaggletooth"]
	path = third_party/snaggletooth
	url = https://github.com/etroimcasso/Snaggletooth.git
